APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# production: APP_ENV=production, APP_DEBUG=false, SESSION_SECURE_COOKIE=true (docs/PRODUCTION.md)
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Separate database used by `php artisan transactions:archive` to store rows exported
# from old sales/purchases/stock tables before they are deleted from the live tables.
DB_ARCHIVE_HOST=127.0.0.1
DB_ARCHIVE_PORT=3306
DB_ARCHIVE_DATABASE=isp360_archive
DB_ARCHIVE_USERNAME=root
DB_ARCHIVE_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
# Router pushes and SMS (see config/isp.php):
#   sync      = run inside the web request (small installations, no worker needed)
#   database  + ISP_QUEUE_IN_SCHEDULER=true = shared hosting: the cron scheduler works the queue every minute
#   redis     = own server: run `php artisan horizon` under Supervisor/systemd (dashboard at /horizon)
QUEUE_CONNECTION=sync
ISP_QUEUE_IN_SCHEDULER=false

# ISP network driver (class implementing App\Services\Network\NetworkDriver).
# MikroTikDriver (RouterOS v7 REST) is idle until a default router is added in Network Setup > Routers.
# Use App\\Services\\Network\\NullNetworkDriver to switch router automation off entirely.
ISP_NETWORK_DRIVER="App\\Services\\Network\\MikroTikDriver"
# FreeRADIUS SQL database for routers set to "RADIUS" (defaults to the app database; the tables are created by the migrations if missing)
# RADIUS_DB_HOST=127.0.0.1
# RADIUS_DB_DATABASE=radius
# RADIUS_DB_USERNAME=radius
# RADIUS_DB_PASSWORD=
# ISP billing runs from the scheduler — add this cron entry on the server:
# * * * * * cd /path/to/app && php artisan schedule:run >> /dev/null 2>&1
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
