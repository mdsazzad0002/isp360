# Uploaded files are data, never code (audit C3). Apache only: on nginx add
#   location ^~ /uploads/ { location ~ \.(php|phtml|phar)$ { deny all; } }
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php[0-9]?|phtml|phar|pl|py|cgi|sh|shtml|htaccess)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
